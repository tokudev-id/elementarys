{
  "name": "elementary-school",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/clean-next.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write src tests scripts *.ts *.mjs .prettierrc.json package.json",
    "format:check": "prettier --check src tests scripts *.ts *.mjs .prettierrc.json package.json",
    "test:integration": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run tests/integration",
    "typecheck": "next typegen && tsc --noEmit",
    "test:domain": "vitest run tests/domain",
    "test:e2e": "playwright test",
    "measure:attendance": "tsx scripts/measure-attendance.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed:test": "tsx scripts/seed.ts",
    "auth:bootstrap-admin": "node --conditions=react-server --import tsx scripts/bootstrap-admin.ts",
    "release:migrate": "node --import tsx scripts/release/migrate.ts",
    "release:bootstrap": "node --conditions=react-server --import tsx scripts/release/bootstrap.ts",
    "smoke:read-only": "node --import tsx scripts/release/smoke.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.7",
    "better-auth": "1.7.7",
    "drizzle-orm": "^0.45.3",
    "exceljs": "4.4.0",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.20.0"
  },
  "type": "module"
}
