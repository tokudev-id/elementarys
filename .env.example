# ==============================================================================
# LOKAL DEVELOPMENT & TEST (.env.local)
# ==============================================================================
APP_ENV=test
PORT=3101
DATABASE_URL=postgresql://school_test@127.0.0.1:55433/elementary_test_dev
DATABASE_MIGRATION_URL=postgresql://school_test@127.0.0.1:55433/elementary_test_dev
TEST_DATABASE_ADMIN_URL=postgresql://school_test@127.0.0.1:55433/postgres
TEST_DB_SUFFIX=dev
BETTER_AUTH_SECRET=local-development-secret-minimum-32-chars-long!
BETTER_AUTH_URL=http://localhost:3101
TRUSTED_ORIGINS=http://localhost:3101
TEST_ACCOUNT_PASSWORD=
DEMO_ACCOUNT_PASSWORD=

# ==============================================================================
# VERCEL PRODUCTION ENVIRONMENT VARIABLES (Atur di Vercel Project Settings)
# ==============================================================================
# APP_ENV=production
#
# URL koneksi pooled Neon PostgreSQL (port 5432/6543 dengan endpoint -pooler):
# DATABASE_URL=postgresql://neondb_owner:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
#
# Secret random minimal 32 karakter untuk enkripsi token/cookie Better Auth:
# BETTER_AUTH_SECRET=generate-random-secret-min-32-chars-using-openssl-rand-hex-32
#
# Domain produksi HTTPS aplikasi:
# BETTER_AUTH_URL=https://my-school.vercel.app
#
# Domain yang diizinkan untuk CORS dan pengiriman formulir (pisahkan dengan koma jika lebih dari satu):
# TRUSTED_ORIGINS=https://my-school.vercel.app
#
# (Opsional untuk migration runner mandiri, jangan diekspos ke klien):
# DATABASE_MIGRATION_URL=postgresql://neondb_owner:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
